{
  "name": "alfa-cbdc-hub-bff",
  "version": "1.0.0",
  "description": "Backend-for-Frontend for Alfa Global CBDC Hub: aggregates deal data, business logic for the UI, caching and the notification service.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "node-cache": "^5.1.2",
    "zod": "^3.23.8",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.4",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@types/cookie-parser": "^1.4.7"
  }
}
