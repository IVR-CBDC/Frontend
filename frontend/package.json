{
  "name": "alfa-cbdc-hub-frontend",
  "version": "1.0.0",
  "description": "Alfa Global CBDC Hub – client SPA (React + TypeScript) for tracking cross-border deals end to end.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
